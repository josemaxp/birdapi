 "consulta": "SELECT occurrence.gbif_classification.specieskey AS specieskey, occurrence.gbif_classification.species AS species, CASE WHEN occurrence.gbif_classification.specieskey IS NULL THEN v_scientificname END AS nombre_fuente,\n  level2gid, level2name, \"year\", \"month\", CASE WHEN datasetkey = '4fa7b334-ce0d-4e88-aaae-2e0c138d049e' THEN 'ebird' WHEN datasetkey = '50c9509d-22c7-4a22-a47d-8c48425ef4a7' THEN 'inaturalist' WHEN publishingorgkey = 'c8d737e0-2ff8-42e8-b8fc-6b805d26fc5f' THEN 'observation' ELSE 'ico' END AS fuente,\n  GBIF_EuroStatCode(1000, decimallatitude, decimallongitude, 0) AS celda, CASE WHEN coordinateuncertaintyinmeters <= 1000 OR (coordinateuncertaintyinmeters IS NULL AND publishingorgkey <> 'ada19a05-4216-44c7-aa4f-6e7177bcb0ac') THEN 1 ELSE 0 END AS preciso, COUNT(*) AS registros, COUNT(DISTINCT \"day\") AS dias\nFROM occurrence\nWHERE countrycode = 'ES' AND (occurrence.gbif_classification.classkey = '212' OR (occurrence.gbif_classification.classkey IS NULL AND occurrence.gbif_classification.specieskey IS NULL))\n  AND \"year\" >= 2020 AND \"year\" <= 2024 AND \"month\" IS NOT NULL\n  AND occurrencestatus = 'PRESENT' AND (hasgeospatialissues = FALSE OR hasgeospatialissues IS NULL)\n  AND level2gid LIKE 'ESP.%'\n  AND decimallatitude IS NOT NULL AND decimallongitude IS NOT NULL\n  AND (coordinateuncertaintyinmeters IS NULL OR coordinateuncertaintyinmeters <= 10000)\n  AND (informationwithheld IS NULL OR informationwithheld NOT LIKE 'Coordinate uncertainty increased%')\n  AND (datasetkey IN ('4fa7b334-ce0d-4e88-aaae-2e0c138d049e', '50c9509d-22c7-4a22-a47d-8c48425ef4a7') OR publishingorgkey IN ('c8d737e0-2ff8-42e8-b8fc-6b805d26fc5f', 'ada19a05-4216-44c7-aa4f-6e7177bcb0ac'))\nGROUP BY occurrence.gbif_classification.specieskey, occurrence.gbif_classification.species, CASE WHEN occurrence.gbif_classification.specieskey IS NULL THEN v_scientificname END, level2gid, level2name, \"year\", \"month\", CASE WHEN datasetkey = '4fa7b334-ce0d-4e88-aaae-2e0c138d049e' THEN 'ebird' WHEN datasetkey = '50c9509d-22c7-4a22-a47d-8c48425ef4a7' THEN 'inaturalist' WHEN publishingorgkey = 'c8d737e0-2ff8-42e8-b8fc-6b805d26fc5f' THEN 'observation' ELSE 'ico' END,\n  GBIF_EuroStatCode(1000, decimallatitude, decimallongitude, 0), CASE WHEN coordinateuncertaintyinmeters <= 1000 OR (coordinateuncertaintyinmeters IS NULL AND publishingorgkey <> 'ada19a05-4216-44c7-aa4f-6e7177bcb0ac') THEN 1 ELSE 0 END",
